# No secret is stored here. Copy to ignored secrets/.env.local and configure on your computer.
OPENAI_API_KEY=
DEMANDLAB_AI_QUERY_MODEL=gpt-5.6-luna
DEMANDLAB_AI_REVIEW_MODEL=gpt-5.6-terra
DEMANDLAB_AI_DECISION_MODEL=gpt-6-astra
# Explicit deployment consent. Requests also require user consent for the selected data.
DEMANDLAB_AI_ENABLED=false
# Keep openai for the existing setup. Local mode never falls back to cloud.
DEMANDLAB_AI_PROVIDER=openai
# For local mode, install an OpenAI-compatible service on this computer and replace
# ALL three model values above with installed model IDs that support tools + JSON schema.
DEMANDLAB_AI_LOCAL_URL=http://127.0.0.1:11434/v1
# These are call/size limits, NOT a dollar spending cap. Set provider billing limits too.
DEMANDLAB_AI_DAILY_CALLS=60
DEMANDLAB_AI_USER_DAILY_CALLS=30
DEMANDLAB_AI_REQUEST_CALLS=6
DEMANDLAB_AI_CONTEXT_BYTES=100000
DEMANDLAB_AI_OUTPUT_TOKENS=2500
