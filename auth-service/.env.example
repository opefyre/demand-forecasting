# Store actual values in ../secrets/.env.local, not this file.
DEMANDLAB_AUTH_MODE=better_auth
DEMANDLAB_PUBLIC_ORIGIN=http://127.0.0.1:8010
DEMANDLAB_AUTH_SERVICE_URL=http://127.0.0.1:8011
DEMANDLAB_AUTH_BRIDGE_SECRET=
BETTER_AUTH_SECRET=
DEMANDLAB_AUTH_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Explicit local-only file delivery. Never enabled on production origins.
DEMANDLAB_AUTH_DEV_MAIL=false
