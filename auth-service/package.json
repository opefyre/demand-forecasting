{
  "name": "demandlab-auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "check": "tsc --noEmit",
    "preflight": "node --import tsx src/preflight.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/identity.integration.test.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "bootstrap": "node --import tsx src/bootstrap.ts",
    "schema:cloudflare": "node --import tsx scripts/generate-cloudflare-schema.ts",
    "schema:cloudflare:check": "node --import tsx scripts/generate-cloudflare-schema.ts --check",
    "test:cloudflare-worker": "node --import tsx scripts/test-cloudflare-worker.ts",
    "test:cloud-storage": "node --import tsx scripts/test-cloud-storage.ts",
    "test:cloud-recovery": "node --import tsx scripts/test-cloud-recovery.ts",
    "test:cloud-engine": "node --test ../deploy/cloudflare/engine-lifecycle.test.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@hono/node-server": "2.1.4",
    "better-auth": "1.7.7",
    "hono": "4.13.13",
    "nodemailer": "10.0.16",
    "pg": "^8.16.3",
    "resend": "6.32.1"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "miniflare": "5.20261006.1-alpha",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
