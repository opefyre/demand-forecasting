{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "demandlab-forecast-edge",
  "account_id": "b53df72f41f5135daf312100e73ff6a1",
  "main": "edge.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "forecast.vrolen.com", "custom_domain": true }
  ],
  "limits": { "cpu_ms": 50 },
  "vars": {"PRIVATE_ACCESS":"closed","OWNER_ONLY_ACCEPTANCE":"true"},
  "assets": {"directory":"../../app/static/client","binding":"ASSETS","run_worker_first":true},
  "services":[
    {"binding":"IDENTITY","service":"demandlab-forecast-identity","entrypoint":"ForecastIdentity"},
    {"binding":"STORAGE","service":"demandlab-forecast-storage","entrypoint":"ForecastStorage"},
    {"binding":"ENGINE","service":"demandlab-forecast-engine","entrypoint":"ForecastRunner"}
  ],
  "observability": { "enabled": false }
}
