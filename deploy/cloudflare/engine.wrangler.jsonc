{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "demandlab-forecast-engine",
  "account_id": "b53df72f41f5135daf312100e73ff6a1",
  "main": "cloud-engine.mjs", "compatibility_date": "2026-10-09",
  "workers_dev": false, "preview_urls": false, "routes": [],
  "observability": {"enabled":false}, "limits":{"cpu_ms":1000},
  "vars":{"PRIVATE_ACCESS":"closed","AI_ENABLED":"false","AI_ELIGIBILITY_CONFIRMED":"false"},
  "services":[
    {"binding":"IDENTITY","service":"demandlab-forecast-identity","entrypoint":"ForecastIdentity"},
    {"binding":"STORAGE","service":"demandlab-forecast-storage","entrypoint":"ForecastStorage"}
  ],
  "durable_objects":{"bindings":[{"name":"ENGINE","class_name":"ForecastEngine"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["ForecastEngine"]}],
  "containers":[{"class_name":"ForecastEngine","scheduling_policy":"durable_object",
    "images":{"base":{"dockerfile":"engine.Dockerfile","build_context":"../.."}},
    "observability":{"logs":{"enabled":false}}}],
  "r2_buckets":[
    {"binding":"FILES","bucket_name":"demandlab-forecast-files"},
    {"binding":"BACKUPS","bucket_name":"demandlab-forecast-backups"}
  ]
}
