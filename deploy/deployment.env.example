# Blank template only. Keep real values outside the checkout, never in Git.
# Linux reference location: /etc/demandlab/secrets/deployment.env (root-owned 0600).
DEMANDLAB_AUTH_MODE=better_auth
DEMANDLAB_PUBLIC_ORIGIN=
DEMANDLAB_AUTH_SERVICE_URL=http://127.0.0.1:8011
BETTER_AUTH_SECRET=
DEMANDLAB_AUTH_BRIDGE_SECRET=
DEMANDLAB_AUTH_DATABASE_URL=
DEMANDLAB_AUTH_DEV_MAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI activation is separate: country eligibility, credential choice and model IDs.
DEMANDLAB_AI_ENABLED=false
# Add exact, company-specific private ERP/SFTP targets only when required.
DEMANDLAB_CONNECTOR_PRIVATE_TARGETS={}
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
NODE_ENV=production
